PORT=3000
NODE_ENV=development
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD_HERE@localhost:5432/unicarona?schema=public
POSTGRES_DB=unicarona
POSTGRES_USER=postgres
POSTGRES_PASSWORD=YOUR_PASSWORD_HERE

JWT_ACCESS_SECRET=your_jwt_access_secret
JWT_REFRESH_SECRET=your_jwt_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

MAIL_FROM=Example@Domain
RESEND_API_KEY=YOR_API_KEY

# Google Maps API (compartilhada com billing/alerta)
# https://console.cloud.google.com/apis/credentials
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY

# Pricing Service
PRICING_BASE_RATE=3.00
PRICING_PER_KM=0.50
PRICING_APP_FEE_PERCENT=10
